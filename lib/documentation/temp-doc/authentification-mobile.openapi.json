{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "STAGIA - API d'authentification mobile",
    "version": "1.0.0",
    "description": "Contrat des routes d'authentification utilisées par l'application mobile STAGIA. Les comptes étudiants sont créés et activés depuis l'application Web."
  },
  "servers": [
    {
      "url": "http://localhost/stagia/api/v1",
      "description": "Wamp sur la machine de développement"
    },
    {
      "url": "http://{host}/stagia/api/v1",
      "description": "Wamp accessible depuis un téléphone sur le réseau local",
      "variables": {
        "host": {
          "default": "192.168.1.20",
          "description": "Adresse IPv4 du PC exécutant Wamp"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Authentification",
      "description": "Connexion, session et récupération du mot de passe"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "tags": ["Authentification"],
        "operationId": "login",
        "summary": "Connecter un utilisateur",
        "description": "Accepte l'identifiant du compte, l'e-mail, le code STAGIA ou un nom non ambigu. Crée une session mobile et retourne un access token et un refresh token.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "examples": {
                "codeStagia": {
                  "summary": "Connexion avec le code STAGIA",
                  "value": {
                    "identifiant": "STG-ETU-00000030",
                    "password": "MotDePasse!2026",
                    "device_name": "Samsung Galaxy A54"
                  }
                },
                "email": {
                  "summary": "Connexion avec l'e-mail",
                  "value": {
                    "identifiant": "etudiant@example.com",
                    "password": "MotDePasse!2026"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connexion réussie",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" },
                "example": {
                  "success": true,
                  "message": "Connexion réussie.",
                  "data": {
                    "access_token": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                    "refresh_token": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                    "token_type": "Bearer",
                    "expires_in": 3600,
                    "refresh_expires_in": 2592000,
                    "user": {
                      "id": 55,
                      "identifiant": "etu.mbimbu",
                      "nom": "MBIMBU",
                      "postnom": "GEMIMA",
                      "prenom": "Gemima",
                      "email": "etudiant@example.com",
                      "actif": true,
                      "statut_compte": "ACTIF",
                      "role": { "code": "STAGIAIRE", "nom": "Stagiaire" },
                      "roles": ["STAGIAIRE"]
                    },
                    "student": {
                      "id": 30,
                      "stagia_code": "STG-ETU-00000030",
                      "nom": "MBIMBU",
                      "postnom": "GEMIMA",
                      "prenom": "Gemima",
                      "statut": "ACTIF"
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": ["Authentification"],
        "operationId": "logout",
        "summary": "Déconnecter la session courante",
        "description": "Supprime uniquement la session API désignée par l'access token courant. Le corps est vide.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Déconnexion réussie",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmptySuccessResponse" },
                "example": {
                  "success": true,
                  "message": "Déconnexion réussie.",
                  "data": []
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/refresh-token": {
      "post": {
        "tags": ["Authentification"],
        "operationId": "refreshToken",
        "summary": "Renouveler la session mobile",
        "description": "Effectue une rotation de l'access token et du refresh token. Les deux anciens jetons deviennent invalides.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" },
              "example": {
                "refresh_token": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Jetons renouvelés",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" },
                "example": {
                  "success": true,
                  "message": "Token renouvelé.",
                  "data": {
                    "access_token": "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
                    "refresh_token": "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
                    "token_type": "Bearer",
                    "expires_in": 3600,
                    "refresh_expires_in": 2592000
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/me": {
      "get": {
        "tags": ["Authentification"],
        "operationId": "getCurrentUser",
        "summary": "Obtenir l'utilisateur courant",
        "description": "Valide l'access token et retourne l'identité, le rôle principal, les rôles actifs et le profil étudiant éventuel.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Utilisateur authentifié",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IdentityResponse" },
                "example": {
                  "success": true,
                  "message": "Utilisateur authentifié.",
                  "data": {
                    "user": {
                      "id": 55,
                      "identifiant": "etu.mbimbu",
                      "nom": "MBIMBU",
                      "postnom": "GEMIMA",
                      "prenom": "Gemima",
                      "email": "etudiant@example.com",
                      "actif": true,
                      "statut_compte": "ACTIF",
                      "role": { "code": "STAGIAIRE", "nom": "Stagiaire" },
                      "roles": ["STAGIAIRE"]
                    },
                    "student": {
                      "id": 30,
                      "stagia_code": "STG-ETU-00000030",
                      "nom": "MBIMBU",
                      "postnom": "GEMIMA",
                      "prenom": "Gemima",
                      "statut": "ACTIF"
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/forgot-password": {
      "post": {
        "tags": ["Authentification"],
        "operationId": "forgotPassword",
        "summary": "Demander un lien de réinitialisation",
        "description": "Retourne toujours la même réponse 202 lorsqu'un identifiant non vide est fourni, que le compte existe ou non. Maximum trois demandes enregistrées en quinze minutes par utilisateur. Le lien expire après soixante minutes.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ForgotPasswordRequest" },
              "examples": {
                "identifiant": {
                  "value": { "identifiant": "STG-ETU-00000030" }
                },
                "email": {
                  "value": { "email": "etudiant@example.com" }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/ForgotPasswordRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Demande acceptée sans révéler l'existence du compte",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmptySuccessResponse" },
                "example": {
                  "success": true,
                  "message": "Si un compte actif correspond à ces informations, un e-mail de réinitialisation sera envoyé.",
                  "data": []
                }
              }
            }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/reset-password": {
      "post": {
        "tags": ["Authentification"],
        "operationId": "resetPassword",
        "summary": "Définir un nouveau mot de passe",
        "description": "Consomme le token à usage unique, modifie le mot de passe et révoque toutes les sessions mobiles du compte.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResetPasswordRequest" },
              "example": {
                "token": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                "password": "NouveauMotDePasse!2026",
                "password_confirmation": "NouveauMotDePasse!2026"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/ResetPasswordRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mot de passe réinitialisé et sessions mobiles révoquées",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmptySuccessResponse" },
                "example": {
                  "success": true,
                  "message": "Mot de passe réinitialisé. Vous pouvez maintenant vous connecter.",
                  "data": []
                }
              }
            }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque token",
        "description": "Access token opaque retourné par /login ou /refresh-token."
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identifiant": {
            "type": "string",
            "minLength": 1,
            "description": "Identifiant, e-mail, code STAGIA ou nom non ambigu."
          },
          "login": {
            "type": "string",
            "minLength": 1,
            "description": "Alias accepté à la place de identifiant."
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1
          },
          "device_name": {
            "type": "string",
            "maxLength": 100,
            "default": "mobile"
          }
        },
        "required": ["password"],
        "anyOf": [
          { "required": ["identifiant"] },
          { "required": ["login"] }
        ]
      },
      "RefreshTokenRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{96}$"
          }
        },
        "required": ["refresh_token"]
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identifiant": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "minLength": 1
          }
        },
        "anyOf": [
          { "required": ["identifiant"] },
          { "required": ["email"] }
        ]
      },
      "ResetPasswordRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "description": "Doit contenir une majuscule, une minuscule, un chiffre et un caractère spécial."
          },
          "password_confirmation": {
            "type": "string",
            "format": "password",
            "minLength": 8
          }
        },
        "required": ["token", "password", "password_confirmation"]
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "refresh_token": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{96}$"
          },
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "const": 3600
          },
          "refresh_expires_in": {
            "type": "integer",
            "const": 2592000
          }
        },
        "required": ["access_token", "refresh_token", "token_type", "expires_in", "refresh_expires_in"]
      },
      "Role": {
        "type": "object",
        "properties": {
          "code": { "type": ["string", "null"] },
          "nom": { "type": ["string", "null"] }
        },
        "required": ["code", "nom"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "identifiant": { "type": ["string", "null"] },
          "nom": { "type": ["string", "null"] },
          "postnom": { "type": ["string", "null"] },
          "prenom": { "type": ["string", "null"] },
          "email": { "type": ["string", "null"], "format": "email" },
          "actif": { "type": "boolean" },
          "statut_compte": {
            "type": "string",
            "enum": ["A_ACTIVER", "ACTIF", "SUSPENDU"]
          },
          "role": { "$ref": "#/components/schemas/Role" },
          "roles": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        },
        "required": ["id", "identifiant", "nom", "postnom", "prenom", "email", "actif", "statut_compte", "role", "roles"]
      },
      "Student": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "stagia_code": { "type": ["string", "null"] },
          "nom": { "type": ["string", "null"] },
          "postnom": { "type": ["string", "null"] },
          "prenom": { "type": ["string", "null"] },
          "statut": {
            "type": "string",
            "enum": ["ACTIF", "SUSPENDU", "ARCHIVE"]
          }
        },
        "required": ["id", "stagia_code", "nom", "postnom", "prenom", "statut"]
      },
      "Identity": {
        "type": "object",
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "student": {
            "oneOf": [
              { "$ref": "#/components/schemas/Student" },
              { "type": "null" }
            ]
          }
        },
        "required": ["user", "student"]
      },
      "LoginData": {
        "allOf": [
          { "$ref": "#/components/schemas/TokenPair" },
          { "$ref": "#/components/schemas/Identity" }
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": true },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/LoginData" }
        },
        "required": ["success", "message", "data"]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": true },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/TokenPair" }
        },
        "required": ["success", "message", "data"]
      },
      "IdentityResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": true },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/Identity" }
        },
        "required": ["success", "message", "data"]
      },
      "EmptyData": {
        "type": "array",
        "maxItems": 0,
        "items": false
      },
      "EmptySuccessResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": true },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/EmptyData" }
        },
        "required": ["success", "message", "data"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": false },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/EmptyData" }
        },
        "required": ["success", "message", "data"]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentification absente, invalide ou expirée",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "examples": {
              "credentials": {
                "value": { "success": false, "message": "Identifiant ou mot de passe incorrect.", "data": [] }
              },
              "token": {
                "value": { "success": false, "message": "Token invalide ou expiré.", "data": [] }
              },
              "refreshToken": {
                "value": { "success": false, "message": "Refresh token invalide ou expiré.", "data": [] }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Compte ou accès non autorisé",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "success": false, "message": "Ce compte ne possède plus d'accès actif.", "data": [] }
          }
        }
      },
      "NotFound": {
        "description": "Utilisateur introuvable",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "success": false, "message": "Utilisateur introuvable.", "data": [] }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "Méthode HTTP incorrecte. La réponse contient aussi l'en-tête Allow.",
        "headers": {
          "Allow": {
            "schema": { "type": "string" },
            "description": "Méthode attendue par la route."
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "success": false, "message": "Méthode HTTP non autorisée.", "data": [] }
          }
        }
      },
      "ValidationError": {
        "description": "Payload manquant ou invalide",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "success": false, "message": "Les données envoyées sont invalides.", "data": [] }
          }
        }
      },
      "InternalError": {
        "description": "Erreur interne",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "success": false, "message": "Une erreur interne empêche l'opération.", "data": [] }
          }
        }
      }
    }
  }
}
